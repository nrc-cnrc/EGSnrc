:start geometry definition:
    :start geometry:
        name = phantom
        library = egs_rz
        number of shells = 1, 101, 1
        shell thickness = 0.005, 0.01, 20
        first plane = -40.
        number of slabs = 1, 203, 1
        slab thickness = 38.985, 0.01, 38.985
        :start media input:
            media = WATER
        :stop media input:
    :stop geometry:

    :start geometry:

        library = egs_cones
        type    = EGS_ConeStack
        axis    = 0 0 0.271 0 0 -1
        name    = capsule_and_source

        :start layer:
            thickness    = 0.0143
            top radii    = 0.0
            bottom radii = 0.055
            media        = SS_AISI316L
        :stop layer:

        :start layer:
           thickness    = 0.0717
           top radii    = 0.055
           bottom radii = 0.055
           media        = SS_AISI316L
        :stop layer:

        :start layer:
           thickness    = 0.01
           top radii    = 0.035 0.055
           bottom radii    = 0.035 0.055
           media        = AIR_TG43 SS_AISI316L
        :stop layer:

        :start layer:
           thickness    = 0.35
           top radii    = 0.03 0.035 0.055
           bottom radii = 0.03 0.035 0.055
           media        = Ir AIR_TG43 SS_AISI316L
        :stop layer:

        :start layer:
           thickness    = 0.05
           top radii    = 0.055
           bottom radii = 0.055
           media        = SS_AISI316L
        :stop layer:

        :start layer:
           thickness    = 6.
           top radii    = 0.055
           bottom radii = 0.055
           media        = SS_AISI304_p5.6
        :stop layer:

    :stop geometry:

    :start geometry:
        name = final
        library = egs_genvelope
        base geometry = phantom
        inscribed geometries = capsule_and_source
    :stop geometry:
    simulation geometry = final
:stop geometry definition:
:start test:
    layers = capsule_and_source phantom
    n rays = 400000
    seed = 1
    centre = 0 0 0
    target box = 0.08 0.08 0.4
    start radius = 1.0
    max distance = 3.0
    inside fraction = 0.5
    tolerance = 1e-7
    dump = 3
:stop test:
