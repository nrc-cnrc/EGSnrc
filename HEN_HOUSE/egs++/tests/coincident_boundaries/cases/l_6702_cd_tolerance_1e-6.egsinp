# The 6702 seed of the egs_brachy test suite (CD geometry, boundary tolerance = 1e-6) on its own.
# A ray leaving an end-cap cylinder through its side 3e-7 cm from the CD dividing plane used to
# loop forever between the end cap, the seed centre and the outside.

:start geometry definition:

    :start geometry:
        library = egs_planes
        name = planes
        type = EGS_Zplanes
        positions = -0.225 -0.185 -0.175 0.175 0.185 0.225
    :stop geometry:

    :start geometry:
        library = egs_spheres
        name = sph_end_cap_1
        midpoint = 0 0  -0.185
        type = EGS_cSpheres
        radii = 0.04

        :start media input:
            media = Ti
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_cylinders
        name = end_cap_1
        midpoint = 0 0  0
        type = EGS_ZCylinders
        radii = 0.04

        :start media input:
            media = Ti
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_cylinders
        name = cladding
        midpoint = 0 0 0
        type = EGS_ZCylinders
        radii = 0.035 0.04

        :start media input:
            media = AIR_TG43 Ti
            set medium = 0 0
            set medium = 1 1
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_spheres
        name = sph_source_1
        midpoint = 0 0  -0.11
        type = EGS_cSpheres
        radii = 0.03

        :start media input:
            media = C12H18NCl
            set medium = 0 0
        :stop media input:
    :stop geometry:


    :start geometry:
        library = egs_spheres
        name = sph_source_2
        midpoint = 0 0  0
        type = EGS_cSpheres
        radii = 0.03

        :start media input:
            media = C12H18NCl
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_spheres
        name = sph_source_3
        midpoint = 0 0  0.11
        type = EGS_cSpheres
        radii = 0.03

        :start media input:
            media = C12H18NCl
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_genvelope
        name = seed_center
        base geometry = cladding
        inscribed geometries = sph_source_1 sph_source_2 sph_source_3
    :stop geometry:

    :start geometry:
        library = egs_cylinders
        name = end_cap_2
        midpoint = 0 0  0
        type = EGS_ZCylinders
        radii = 0.04

        :start media input:
            media = Ti
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_spheres
        name = sph_end_cap_2
        midpoint = 0 0  0.185
        type = EGS_cSpheres
        radii = 0.04

        :start media input:
            media = Ti
            set medium = 0 0
        :stop media input:
    :stop geometry:

    :start geometry:
        library = egs_cdgeometry
        name = seed
        base geometry = planes
        set geometry = 0 sph_end_cap_1
        set geometry = 1 end_cap_1
        set geometry = 2 seed_center
        set geometry = 3 end_cap_2
        set geometry = 4 sph_end_cap_2

        boundary tolerance = 1E-6

    :stop geometry:

    simulation geometry = seed
:stop geometry definition:
:start test:
    layers = seed
    n rays = 400000
    seed = 1
    centre = 0 0 0
    target box = 0.045 0.045 0.23
    start radius = 1.0
    max distance = 2.0
    inside fraction = 0.8
    tolerance = 1e9
    dump = 3
:stop test:
