# RZ phantom: off-axis seed whose side reaches 1 um past the ring at r = 0.5 cm.
:start geometry definition:
    :start geometry:
        name = seed
        library = egs_rz
        radii = 0.04
        z-planes = -0.225 0.225
        :start media input:
            media = SEED
        :stop media input:
    :stop geometry:
    :start geometry:
        name = phantom
        library = egs_rz
        number of shells = 20
        shell thickness = 0.1
        first plane = -1
        number of slabs = 20
        slab thickness = 0.1
        :start media input:
            media = WATER
        :stop media input:
    :stop geometry:
    :start geometry:
        name = copy1
        library = egs_gtransformed
        my geometry = seed
        :start transformation:
            translation = 0.4601 0 0
        :stop transformation:
    :stop geometry:
    :start geometry:
        name = final
        library = egs_autoenvelope
        base geometry = phantom
        :start inscribed geometry:
            inscribed geometry name = seed
            :start transformations:
            :start transformation:
                translation = 0.4601 0 0
            :stop transformation:
            :stop transformations:
            :start region discovery:
                action = discover
                density of random points (cm^-3) = 1E4
                superset = yes
                :start shape:
                    type = box
                    box size = 0.082 0.082 0.452
                    :start transformation:
                        translation = 0 0 0
                    :stop transformation:
                :stop shape:
            :stop region discovery:
        :stop inscribed geometry:
    :stop geometry:
    simulation geometry = final
:stop geometry definition:

:start test:
    base geometry = phantom
    layers = copy1
    probe = 0.5 -0.005 -0.2 0.5001 0.005 0.2
    probe = 0.3 -0.2 -0.4 0.6 0.2 0.4
    n points = 200000
    seed = 1
    expect missed = no
    expect leak warning = no
:stop test:
