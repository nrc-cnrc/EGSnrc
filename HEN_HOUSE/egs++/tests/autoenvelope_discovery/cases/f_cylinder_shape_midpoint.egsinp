# Cylinder bounding shape with a midpoint: the box must not be shifted twice.
:start geometry definition:
    :start geometry:
        name = seed
        library = egs_rz
        radii = 0.04
        z-planes = -0.125 0.325
        :start media input:
            media = SEED
        :stop media input:
    :stop geometry:
    :start geometry:
        name = phantom
        library = egs_ndgeometry
        type = EGS_XYZGeometry
        x-slabs = -1 0.1 20
        y-slabs = -1 0.1 20
        z-slabs = -1 0.1 20
        :start media input:
            media = WATER
        :stop media input:
    :stop geometry:
    :start geometry:
        name = copy1
        library = egs_gtransformed
        my geometry = seed
        :start transformation:
            translation = 0.05 0.05 -0.1751
        :stop transformation:
    :stop geometry:
    :start geometry:
        name = final
        library = egs_autoenvelope
        base geometry = phantom
        :start inscribed geometry:
            inscribed geometry name = seed
            :start transformations:
            :start transformation:
                translation = 0.05 0.05 -0.1751
            :stop transformation:
            :stop transformations:
            :start region discovery:
                action = discover
                density of random points (cm^-3) = 1E4
                superset = yes
                :start shape:
                    type = cylinder
                    radius = 0.041
                    height = 0.452
                    midpoint = 0 0 0.1
                :stop shape:
            :stop region discovery:
        :stop inscribed geometry:
    :stop geometry:
    simulation geometry = final
:stop geometry definition:

:start test:
    base geometry = phantom
    layers = copy1
    probe = 0 0 -0.3001 0.1 0.1 -0.3
    probe = -0.2 -0.2 -0.5 0.3 0.3 0.4
    n points = 200000
    seed = 1
    expect missed = no
    expect leak warning = no
:stop test:
